# Copy this file to `.env.local` and fill in the values for local development.
# `.env.local` is gitignored and must not be committed.

# ---------- アプリ環境識別 ----------
# "production" のときのみ robots.txt が検索エンジンに全ページ公開する。
# ステージング / プレビューでは "staging" を入れて noindex にする。
# ローカル開発では未設定でもよい（未設定＝拒否側になる）。
APP_ENV=

# ---------- Supabase ----------
# Local dev defaults (supabase start の出力を使用)
# 注意: Supabase Auth の invite / reset link は 127.0.0.1:54321 で session cookie を
# セットするため、app も 127.0.0.1 でアクセスしないと cookie が跨がず中継画面で
# セッション未確立になる。localhost / 127.0.0.1 は混在させず 127.0.0.1 に統一。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# NOTE: 実際の Stripe ID（bpc_ や price_）はプロジェクト管理者が手元で別途保管しています。
# ローカル開発時は、管理者から Stripe サンドボックスの実 ID を受け取って .env.local に貼り付けてください。
# Vercel（staging / 本番）の環境変数は Vercel Dashboard 側で個別管理しています。
# ---------- Stripe ----------
# Stripe Dashboard (test mode) > Developers > API keys から取得
# https://dashboard.stripe.com/test/apikeys
# 秘密キーは絶対にコミットしないこと（GitHub push protection でブロックされる）
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret — ローカルでは `stripe listen --print-secret` で取得
# 開発中は別ターミナルで以下を起動しておくこと:
#   stripe listen --forward-to http://localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Customer Portal Configuration ID (カード情報更新 + 請求履歴 のみ有効にする)
# 作成方法: stripe billing_portal configurations create ... (README 参照)
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_ME

# Price IDs — 基本プラン (月額 subscription)
STRIPE_PRICE_INDIVIDUAL=price_REPLACE_ME_INDIVIDUAL               # ¥3,800 / 月
STRIPE_PRICE_SMALL=price_REPLACE_ME_SMALL                         # ¥14,800 / 月
STRIPE_PRICE_CORPORATE=price_REPLACE_ME_CORPORATE                 # ¥48,000 / 月
STRIPE_PRICE_CORPORATE_PREMIUM=price_REPLACE_ME_CORPORATE_PREMIUM # ¥148,000 / 月

# Price IDs — 基本プラン (年額 subscription、P3)
# 作成方法: node scripts/stripe/setup-yearly-prices.mjs（年額 Price 4 つ + プラン変更用ポータル設定を作成し、下記 5 行を出力する）
STRIPE_PRICE_INDIVIDUAL_YEARLY=price_REPLACE_ME_INDIVIDUAL_YEARLY               # ¥45,600 / 年（暫定: 月額×12）
STRIPE_PRICE_SMALL_YEARLY=price_REPLACE_ME_SMALL_YEARLY                         # ¥177,600 / 年
STRIPE_PRICE_CORPORATE_YEARLY=price_REPLACE_ME_CORPORATE_YEARLY                 # ¥576,000 / 年
STRIPE_PRICE_CORPORATE_PREMIUM_YEARLY=price_REPLACE_ME_CORPORATE_PREMIUM_YEARLY # ¥1,776,000 / 年

# Customer Portal Configuration ID（プラン変更確認用、P3）
# アップグレード（上位プラン / 月払い→年払い）を Stripe ホスト画面（subscription_update_confirm）で行うための設定。
# 既存の STRIPE_PORTAL_CONFIGURATION_ID（カード更新 + 請求履歴）とは別に持つ。上記スクリプトが作成する
STRIPE_PORTAL_UPDATE_CONFIGURATION_ID=bpc_REPLACE_ME_UPDATE

# Price IDs — 初期費用 (one-time)
STRIPE_PRICE_INITIAL_FEE=price_REPLACE_ME_INITIAL_FEE             # ¥20,000 (初回申込時のみ)

# Price IDs — 補償オプション (月額 subscription)
STRIPE_PRICE_COMPENSATION_5000=price_REPLACE_ME_COMPENSATION_5000 # ¥5,000 / 月
STRIPE_PRICE_COMPENSATION_9800=price_REPLACE_ME_COMPENSATION_9800 # ¥9,800 / 月

# Price IDs — 単発オプション (one-time)
STRIPE_PRICE_URGENT=price_REPLACE_ME_URGENT                       # ¥20,000 (7日間有効)
STRIPE_PRICE_VIDEO=price_REPLACE_ME_VIDEO                         # ¥100,000 (受注者PR動画)
STRIPE_PRICE_VIDEO_WORKPLACE=price_REPLACE_ME_VIDEO_WORKPLACE     # ¥100,000 (職場紹介動画掲載)

# ---------- iron-session ----------
# fee=free Cookie の暗号化キー (32文字以上)。生成: `openssl rand -hex 32`
SESSION_SECRET=

# ---------- Resend (email) ----------
# https://resend.com > API Keys から取得
RESEND_API_KEY=re_xxx
# 送信元アドレス (Resend で SPF/DKIM 設定済みのドメインを指定すること)
EMAIL_FROM=noreply@bijiyuu.net

# ---------- 運営通知 ----------
# 孤児 auth.users 検出（Task 14.2）等、運営対応が必要な異常通知の宛先
OPS_NOTIFICATION_EMAIL=ops@example.com

# ---------- Cloudflare Stream (動画アップロード, P4) ----------
# 未設定でも動画の URL 貼り付け登録（TikTok 等）は動く。MP4 のアップロード・削除・状態確認にだけ必要
# Account ID: Cloudflare ダッシュボード > Stream の右側「Account ID」
CLOUDFLARE_ACCOUNT_ID=
# API トークン: My Profile > API Tokens > Create Token（権限: Account > Stream > Edit）
CLOUDFLARE_STREAM_API_TOKEN=
# Webhook 署名の secret: `node scripts/cloudflare/setup-stream-webhook.mjs <通知URL>` の出力
# 通知 URL は https://<ホスト>/api/webhooks/cloudflare-stream
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
